#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

&mt {
    flavor = "balanced";
    tapping-term-ms = <200>;
};

&lt {
    flavor = "balanced";
    tapping-term-ms = <200>;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            /*
             * 32-key layout. The prior 34-key map included &kp G and
             * &kp H bound to pro_micro D3 (gpio0 20) -- confirmed
             * against the schematic to have no switch wired to it, so
             * those bindings were never reachable in hardware. That
             * pin now carries the wired split UART instead.
             */
            bindings = <
                      &kp Q          &kp W        &kp E         &kp R         &kp T                       &kp Y        &kp U         &kp I         &kp O          &kp P
            &kp LBKT  &mt LSHFT A    &mt LCTRL S  &mt LCMD D    &mt LALT F                                             &mt LALT J    &mt LCMD K    &mt LCTRL L    &mt LSHFT SEMI &kp BSPC
                      &mt LCTRL Z    &mt LCMD X   &mt LALT C    &kp V         &kp B                       &kp N        &kp M         &kp COMMA     &kp DOT        &kp FSLH
                                                                              &lt 1 SPACE                 &lt 2 ENTER
            >;
        };

        sym_layer {
            bindings = <
                      &kp N1         &kp N2       &kp N3        &kp N4        &kp N5                      &kp N6       &kp N7        &kp N8        &kp N9         &kp N0
            &kp RBKT  &mt LSHFT EXCL &mt LCTRL AT &mt LCMD HASH &mt LALT DLLR                                          &mt LALT AMPS &mt LCMD STAR &mt LCTRL LPAR &mt LSHFT RPAR &kp DEL
                      &kp F1         &kp F2       &kp F3        &kp F4        &kp F5                      &kp GRAVE    &kp APOS      &kp MINUS     &kp EQUAL      &kp BSLH
                                                                              &trans                      &mo 3
            >;
        };

        nav_layer {
            bindings = <
                      &none          &kp PG_UP    &kp UP        &kp PG_DN     &kp C_VOL_UP                &none        &none         &kp INS       &none          &kp PSCRN
            &kp RBKT  &none          &kp LEFT     &kp DOWN      &kp RIGHT                                              &kp LALT      &kp LCMD      &kp LCTRL      &kp LSHFT      &kp DEL
                      &none          &kp HOME     &kp ESC       &kp END       &kp C_MUTE                  &none        &none         &none         &none          &none
                                                                              &lt 3 TAB                   &trans
            >;
        };

        fn_layer {
            bindings = <
                      &kp F1         &kp F2       &kp F3        &kp F4        &kp F5                      &kp F6       &kp F7        &kp F8        &kp F9         &kp F10
            &none     &kp F11        &kp F12      &none         &none                                                  &none         &none         &none          &none          &none
                      &none          &none        &none         &none         &bootloader                 &bootloader  &none         &none         &none          &sys_reset
                                                                              &trans                      &trans
            >;
        };

    };
};
